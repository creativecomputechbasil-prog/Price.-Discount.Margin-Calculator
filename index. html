<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Margin & GST Calculator</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: -apple-system, sans-serif; background-color: #f1f3f4; color: #333; }

        header { background-color: #1a252f; color: white; display: flex; align-items: center; padding: 10px; }
        header div { display: flex; align-items: center; gap: 8px; font-weight: bold; }
        .tool-icon { font-size: 20px; }

        .btn { padding: 8px 15px; font-weight: bold; border-radius: 4px; border: none; cursor: pointer; }
        .btn-copy { background-color: #3b5998; color: white; }
        .btn-reset { background-color: #dc3545; color: white; }

        table { width: 100%; border-collapse: collapse; table-layout: fixed; }
        th, td { border: 1px solid #c8d1d3; border-collapse: collapse; text-align: center; }
        input, select { width: 100%; border: none; padding: 10px 2px; text-align: center; }
        select { text-align-last: center; font-size: 11px; font-weight: bold; }
        input:focus, select:focus { outline: none; background-color: rgba(255, 255, 255, 0.8); }

        .del-btn { position: absolute; right: 2px; top: 50%; transform: translateY(-50%); }

        .row-num { background-color: #eff2f3; width: 28px; color: #555; font-size: 12px; }

        th { color: white; font-weight: bold; font-size: 11px; padding: 6px 2px; }
        th span { display: block; font-size: 9px; font-weight: normal; opacity: 0.8; }

        /* Columns exact matching colors */
        th.col-a, td.col-a { background-color: #3880ff; }
        th.col-z, td.col-z { background-color: #2dd3e1; }
        th.col-x, td.col-x { background-color: #3dc2ba; }
        th.col-gst, td.col-gst { background-color: #2fdf75; }
        th.col-b, td.col-b { background-color: #b06efc; }
        th.col-qty, td.col-qty { background-color: #10dc60; }
        th.col-c, td.col-c { background-color: #ffc409; }
        th.col-del { background-color: #eff2f3; color: #555; border-left: 2px solid #ccc; }

        .total-row { border-top: 3px solid #0d1116; color: white; }
        .total-row td { padding: 12px 2px; font-weight: bold; text-align: center; }
        .total-row .total-label { text-align: center; color: #555; background-color: #eff2f3; }

        input, select, .rem-val { color: rgba(0, 0, 0, 0.85); }

        .total-row td { color: white; text-shadow: 0 0 1px rgba(0, 0, 0, 0.4); }

        .total-row .col-a { background-color: #1e56b3; }
        .total-row .col-z { background-color: #10949f; }
        .total-row .col-x { background-color: #1b85b0; }
        .total-row .col-gst { background-color: #0b9e4a; }
        .total-row .col-b { background-color: #7934d4; }
        .total-row .col-qty { background-color: #0ca640; }
        .total-row .col-c { background-color: #cc9900; }
    </style>
</head>
<body>

<header>
    <div>
        <span class="tool-icon">🧮</span>
        <span>MARGIN & GST CALCULATOR</span>
    </div>
</header>

<div style="padding: 10px;">
    <button class="btn btn-copy">COPY</button>
    <button class="btn btn-reset">RESET</button>
</div>

<table>
    <thead>
        <tr>
            <th class="col-del">#</th>
            <th class="col-a">A<br><span>PRICE</span></th>
            <th class="col-z">Z<br><span>DISC %</span></th>
            <th class="col-x">X<br><span>DISC PRICE</span></th>
            <th class="col-gst">GST MODE<br><span>PRICE+GST</span></th>
            <th class="col-b">B<br><span>MARGIN</span></th>
            <th class="col-qty">QTY<br><span>COUNT</span></th>
            <th class="col-c">C<br><span>TOTAL</span></th>
        </tr>
    </thead>
    <tbody id="tableBody">
        <!-- Dynamic rows generated by JavaScript -->
    </tbody>
    <tfoot>
        <tr class="total-row">
            <td class="total-label">TOT</td>
            <td class="col-a">0.00</td>
            <td class="col-z">0.00</td>
            <td class="col-x">0.00</td>
            <td class="col-gst">0.00</td>
            <td class="col-b">0.00</td>
            <td class="col-qty">0</td>
            <td class="col-c">0.00</td>
        </tr>
    </tfoot>
</table>

<script>
    function createTable() {
        const tbody = document.getElementById('tableBody');
        tbody.innerHTML = '';
        for (let i = 1; i <= 14; i++) {
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td class="row-num">${i}</td>
                <td class="col-a"><input type="number" placeholder="0.00"></td>
                <td class="col-z"><input type="number" placeholder="0.00"></td>
                <td class="col-x"><input type="number" placeholder="0.00" readonly></td>
                <td class="col-gst">
                    <select>
                        <option>18% GST INCL.</option>
                        <option>18% GST EXCL.</option>
                        <option>12% GST INCL.</option>
                        <option>5% GST INCL.</option>
                    </select>
                </td>
                <td class="col-b"><input type="number" placeholder="0.00"></td>
                <td class="col-qty"><input type="number" value="1"></td>
                <td class="col-c"><input type="number" placeholder="0.00" readonly></td>
            `;
            tbody.appendChild(tr);
        }
    }

    createTable();
</script>

</body>
</html>
