<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Margin & GST Calculator</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: -apple-system, sans-serif; background-color: #f1f3f4; color: #333; }

        header { 
            background-color: #1a252f; 
            color: white; 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            padding: 10px 12px; 
        }

        .header-title { display: flex; align-items: center; gap: 8px; font-weight: bold; font-size: 16px; }
        .header-buttons { display: flex; gap: 8px; }

        .btn { padding: 8px 16px; font-weight: bold; border-radius: 4px; border: none; cursor: pointer; font-size: 13px; }
        .btn-copy { background-color: #3b5998; color: white; }
        .btn-reset { background-color: #dc3545; color: white; }

        table { width: 100%; border-collapse: collapse; table-layout: fixed; }
        th, td { border: 1px solid #c8d1d3; border-collapse: collapse; text-align: center; font-size: 13px; }
        input, select { width: 100%; border: none; padding: 10px 2px; text-align: center; background: transparent; }
        select { text-align-last: center; font-size: 11px; font-weight: bold; }
        input:focus, select:focus { outline: none; background-color: rgba(255, 255, 255, 0.8); }

        .row-num { background-color: #eff2f3; width: 28px; color: #555; font-size: 12px; }

        th { color: white; font-weight: bold; font-size: 11px; padding: 6px 2px; }
        th span { display: block; font-size: 9px; font-weight: normal; opacity: 0.8; }

        /* Exact matching column colors */
        th.col-a, td.col-a { background-color: #3880ff; }
        th.col-z, td.col-z { background-color: #2dd3e1; }
        th.col-x, td.col-x { background-color: #3dc2ba; }
        th.col-gst, td.col-gst { background-color: #2fdf75; }
        th.col-b, td.col-b { background-color: #b06efc; }
        th.col-qty, td.col-qty { background-color: #10dc60; }
        th.col-c, td.col-c { background-color: #ffc409; }
        th.col-del, td.col-del { background-color: #eff2f3; color: #555; cursor: pointer; font-weight: bold; width: 30px; }

        .gst-cell-container { display: flex; flex-direction: column; align-items: center; justify-content: center; }
        .gst-val-sub { font-size: 11px; padding-bottom: 4px; color: #222; font-weight: bold; }

        .total-row { border-top: 3px solid #0d1116; color: white; }
        .total-row td { padding: 12px 2px; font-weight: bold; text-align: center; }
        .total-row .total-label { text-align: center; color: #555; background-color: #eff2f3; }

        .total-row .col-a { background-color: #1e56b3; }
        .total-row .col-z { background-color: #10949f; }
        .total-row .col-x { background-color: #1b85b0; }
        .total-row .col-gst { background-color: #0b9e4a; }
        .total-row .col-b { background-color: #7934d4; }
        .total-row .col-qty { background-color: #0ca640; }
        .total-row .col-c { background-color: #cc9900; }
    </style>
</head>
<body>

<header>
    <div class="header-title">
        <span>MARGIN & GST CALCULATOR</span>
    </div>
    <div class="header-buttons">
        <button class="btn btn-copy" onclick="copyTable()">COPY</button>
        <button class="btn btn-reset" onclick="resetTable()">RESET</button>
    </div>
</header>

<table>
    <thead>
        <tr>
            <th class="col-del">#</th>
            <th class="col-a">A<br><span>PRICE</span></th>
            <th class="col-z">Z<br><span>DISC %</span></th>
            <th class="col-x">X<br><span>DISC PRICE</span></th>
            <th class="col-gst">GST MODE<br><span>PRICE+GST</span></th>
            <th class="col-b">B<br><span>MARGIN</span></th>
            <th class="col-qty">QTY<br><span>COUNT</span></th>
            <th class="col-c">C<br><span>TOTAL</span></th>
            <th class="col-del">DEL</th>
        </tr>
    </thead>
    <tbody id="tableBody">
        <!-- Dynamic rows generated by JS -->
    </tbody>
    <tfoot>
        <tr class="total-row">
            <td class="total-label">TOT</td>
            <td class="col-a" id="tot-a">0.00</td>
            <td class="col-z" id="tot-z">0.00</td>
            <td class="col-x" id="tot-x">0.00</td>
            <td class="col-gst" id="tot-gst">0.00</td>
            <td class="col-b" id="tot-b">0.00</td>
            <td class="col-qty" id="tot-qty">0</td>
            <td class="col-c" id="tot-c">0.00</td>
            <td class="col-del"></td>
        </tr>
    </tfoot>
</table>

<script>
    function createTable() {
        const tbody = document.getElementById('tableBody');
        tbody.innerHTML = '';
        for (let i = 1; i <= 14; i++) {
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td class="row-num">${i}</td>
                <td class="col-a"><input type="number" class="in-a" value="0" oninput="calculate()"></td>
                <td class="col-z"><input type="number" class="in-z" value="0" oninput="calculate()"></td>
                <td class="col-x"><input type="text" class="in-x" value="0.00" readonly></td>
                <td class="col-gst">
                    <div class="gst-cell-container">
                        <select class="in-gst-sel" onchange="calculate()">
                            <option value="18">+18%</option>
                            <option value="12">+12%</option>
                            <option value="5">+5%</option>
                            <option value="0">0%</option>
                        </select>
                        <span class="gst-val-sub in-gst-val">0.00</span>
                    </div>
                </td>
                <td class="col-b"><input type="number" class="in-b" value="0" oninput="calculate()"></td>
                <td class="col-qty"><input type="number" class="in-qty" value="1" oninput="calculate()"></td>
                <td class="col-c"><input type="text" class="in-c" value="0.00" readonly></td>
                <td class="col-del" onclick="clearRow(this)">×</td>
            `;
            tbody.appendChild(tr);
        }
        calculate();
    }

    function calculate() {
        const rows = document.querySelectorAll('#tableBody tr');
        let totA = 0, totZ = 0, totX = 0, totGst = 0, totB = 0, totQty = 0, totC = 0;

        rows.forEach(tr => {
            const price = parseFloat(tr.querySelector('.in-a').value) || 0;
            const discPct = parseFloat(tr.querySelector('.in-z').value) || 0;
            const gstPct = parseFloat(tr.querySelector('.in-gst-sel').value) || 0;
            const margin = parseFloat(tr.querySelector('.in-b').value) || 0;
            const qty = parseFloat(tr.querySelector('.in-qty').value) || 0;

            // Calculations
            const discPrice = price - (price * (discPct / 100));
            const priceWithGst = discPrice + (discPrice * (gstPct / 100));
            const total = (priceWithGst + margin) * qty;

            // Set Row Outputs
            tr.querySelector('.in-x').value = discPrice.toFixed(2);
            tr.querySelector('.in-gst-val').innerText = priceWithGst.toFixed(2);
            tr.querySelector('.in-c').value = total.toFixed(2);

            // Accumulate Totals
            totA += price;
            totZ += discPct;
            totX += discPrice;
            totGst += priceWithGst;
            totB += margin;
            totQty += qty;
            totC += total;
        });

        // Set Footers
        document.getElementById('tot-a').innerText = totA.toFixed(2);
        document.getElementById('tot-z').innerText = totZ.toFixed(2);
        document.getElementById('tot-x').innerText = totX.toFixed(2);
        document.getElementById('tot-gst').innerText = totGst.toFixed(2);
        document.getElementById('tot-b').innerText = totB.toFixed(2);
        document.getElementById('tot-qty').innerText = totQty;
        document.getElementById('tot-c').innerText = totC.toFixed(2);
    }

    function clearRow(btn) {
        const tr = btn.parentElement;
        tr.querySelector('.in-a').value = 0;
        tr.querySelector('.in-z').value = 0;
        tr.querySelector('.in-b').value = 0;
        tr.querySelector('.in-qty').value = 1;
        tr.querySelector('.in-gst-sel').value = "18";
        calculate();
    }

    function resetTable() {
        createTable();
    }

    function copyTable() {
        let text = "PRICE\tDISC%\tDISC PRICE\tPRICE+GST\tMARGIN\tQTY\tTOTAL\n";
        const rows = document.querySelectorAll('#tableBody tr');
        rows.forEach(tr => {
            const price = tr.querySelector('.in-a').value;
            const disc = tr.querySelector('.in-z').value;
            const discPrice = tr.querySelector('.in-x').value;
            const gstVal = tr.querySelector('.in-gst-val').innerText;
            const margin = tr.querySelector('.in-b').value;
            const qty = tr.querySelector('.in-qty').value;
            const total = tr.querySelector('.in-c').value;
            text += `${price}\t${disc}\t${discPrice}\t${gstVal}\t${margin}\t${qty}\t${total}\n`;
        });
        navigator.clipboard.writeText(text);
        alert("Table content copied to clipboard!");
    }

    createTable();
</script>

</body>
</html>
