<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Price, Discount & Margin Calculator</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        body {
            background-color: #0f172a;
            color: #ffffff;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .calculator-card {
            background-color: #1e293b;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
            width: 100%;
            max-width: 400px;
        }

        h2 {
            margin-bottom: 20px;
            text-align: center;
            color: #38bdf8;
        }

        .input-group {
            margin-bottom: 15px;
        }

        label {
            display: block;
            margin-bottom: 5px;
            font-size: 14px;
            color: #cbd5e1;
        }

        input {
            width: 100%;
            padding: 10px;
            border-radius: 6px;
            border: 1px solid #334155;
            background-color: #0f172a;
            color: #ffffff;
            font-size: 16px;
        }

        button {
            width: 100%;
            padding: 12px;
            background-color: #0284c7;
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 16px;
            cursor: pointer;
            margin-top: 10px;
        }

        button:hover {
            background-color: #0369a1;
        }

        .result {
            margin-top: 20px;
            padding: 15px;
            background-color: #0f172a;
            border-radius: 6px;
            text-align: center;
        }

        .result p {
            margin: 5px 0;
            font-size: 16px;
        }

        .highlight {
            color: #4ade80;
            font-weight: bold;
        }
    </style>
</head>
<body>

<div class="calculator-card">
    <h2>Price & Margin Calculator</h2>

    <div class="input-group">
        <label for="originalPrice">Original Price ($)</label>
        <input type="number" id="originalPrice" placeholder="e.g. 100">
    </div>

    <div class="input-group">
        <label for="discountPercent">Discount (%)</label>
        <input type="number" id="discountPercent" placeholder="e.g. 20">
    </div>

    <button onclick="calculate()">Calculate</button>

    <div class="result" id="resultBox" style="display: none;">
        <p>Final Price: <span class="highlight" id="finalPrice">$0.00</span></p>
        <p>You Saved: <span class="highlight" id="savedAmount">$0.00</span></p>
    </div>
</div>

<script>
    function calculate() {
        const price = parseFloat(document.getElementById('originalPrice').value);
        const discount = parseFloat(document.getElementById('discountPercent').value);

        if (isNaN(price) || isNaN(discount)) {
            alert('Please enter valid numbers');
            return;
        }

        const saved = (price * discount) / 100;
        const final = price - saved;

        document.getElementById('finalPrice').innerText = '$' + final.toFixed(2);
        document.getElementById('savedAmount').innerText = '$' + saved.toFixed(2);
        document.getElementById('resultBox').style.display = 'block';
    }
</script>

</body>
</html>
